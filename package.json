{
  "name": "skaly-portal",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r exec eslint .",
    "db:migrate": "pnpm --filter @skaly/api db:migrate",
    "db:rollback": "pnpm --filter @skaly/api db:rollback",
    "db:status": "pnpm --filter @skaly/api db:status",
    "db:seed": "pnpm --filter @skaly/api db:seed",
    "db:refresh-views": "pnpm --filter @skaly/api db:refresh-views"
  },
  "devDependencies": {
    "eslint": "^9"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0",
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<11.1.1": ">=11.1.1",
      "dompurify@<3.4.11": ">=3.4.11",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
