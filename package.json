{
  "name": "skaly-portal",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r exec eslint . --max-warnings 0",
    "db:migrate": "pnpm --filter @skaly/api db:migrate",
    "db:rollback": "pnpm --filter @skaly/api db:rollback",
    "db:status": "pnpm --filter @skaly/api db:status",
    "db:seed": "pnpm --filter @skaly/api db:seed",
    "db:refresh-views": "pnpm --filter @skaly/api db:refresh-views"
  },
  "devDependencies": {
    "eslint": "^9"
  },
  "pnpm": {
    "comment": "Transitive advisory pins. Each entry exists because the vulnerable package is pulled in by something we do not control the version of; a direct dependency is bumped in its own package.json instead of pinned here. Ranges mirror the advisory exactly so an entry stops applying once the ecosystem catches up. Re-check with `pnpm audit` and delete anything that no longer matches.",
    "overrides": {
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "undici@>=7.0.0 <7.28.0": "^7.28.0",
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<11.1.1": ">=11.1.1",
      "dompurify@<3.4.12": ">=3.4.12",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "fast-uri@>=3.0.0 <3.1.4": ">=3.1.4",
      "find-my-way@<=9.6.0": ">=9.7.0",
      "sharp@<0.35.0": ">=0.35.0",
      "brace-expansion@<1.1.16": ">=1.1.16",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0",
      "hono@>=4.0.0 <4.12.27": ">=4.12.27",
      "@hono/node-server@<2.0.5": ">=2.0.5"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
